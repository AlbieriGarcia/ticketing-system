# Copiar como .env en la raíz del servidor y cambiar los valores. Nunca commitear el .env real.
# Generar contraseñas con: openssl rand -hex 16

# Dominio público. Sin dominio propio sirve sslip.io con la IP del servidor separada por guiones
DOMAIN=203-0-113-10.sslip.io

# Credenciales internas (no se exponen a internet)
DB_PASSWORD=change-me
STATS_READER_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
STATS_API_KEY=change-me

# Accesos de la demo: el admin de la app y el de Seq se comparten con el evaluador
ADMIN_PASSWORD=admin1234
SEQ_ADMIN_PASSWORD=seqadmin1234
