{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.PhpEventsClient.ClientHandler": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "PhpApi": {
    "BaseUrl": "http://php-api:8000/api"
  },
  "ConnectionStrings": {
    "Stats": ""
  },
  "Security": {
    "ApiKey": ""
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "UserName": "",
    "Password": ""
  }
}
